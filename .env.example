# ============================================================
# ReviewLens AI – Environment Variables
# Copy this file to .env and fill in values for local dev.
# NEVER commit .env or any real secrets.
# ============================================================

# ── Environment ─────────────────────────────────────────────
ENV=local                              # local | staging | production
SERVICE_NAME=api                       # api | chat | consumer | sweeper

# ── Database ─────────────────────────────────────────────────
# Local: direct psycopg connection string (used by Docker Compose)
DATABASE_URL=postgresql+psycopg://reviewlens:reviewlens@localhost:5432/reviewlens
# AWS (Lambda/production): Aurora RDS Data API ARNs (read from Secrets Manager at runtime)
# AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:reviewlens
# AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:reviewlens-db

# ── Object Store ─────────────────────────────────────────────
S3_BUCKET=reviewlens-local             # bucket name; created by LocalStack in compose
AWS_ENDPOINT_URL=http://localhost:4566 # LocalStack endpoint (local only; unset in AWS)

# ── SQS Queue URLs ───────────────────────────────────────────
CHECK_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/check-queue
PROCESSING_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/processing-queue.fifo
PUSH_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/push-queue

# ── DynamoDB Table Names ─────────────────────────────────────
RATE_LIMITS_TABLE=rate-limits
CHECK_SESSIONS_TABLE=check-sessions
WS_CONNECTIONS_TABLE=ws-connections

# ── EventBridge ──────────────────────────────────────────────
EVENTBRIDGE_BUS_NAME=reviewlens-events

# ── AI Provider (Anthropic) ──────────────────────────────────
# Read from Secrets Manager in AWS; set directly in .env locally.
ANTHROPIC_API_KEY=sk-ant-...           # get from console.anthropic.com
CLAUDE_CHAT_MODEL=claude-sonnet-5-5
CLAUDE_EXTRACT_MODEL=claude-haiku-4-5-20251001
CLAUDE_PRECHECK_MODEL=claude-haiku-4-5-20251001

# ── CDN / Origin Guard ───────────────────────────────────────
# The CloudFront distribution adds this header to every request.
# Keep it long and random; rotate it via Secrets Manager in production.
ORIGIN_VERIFY_SECRET=local-dev-secret-change-in-production

# ── Crawl & Data Limits ──────────────────────────────────────
MAX_PAGES=10
MAX_REVIEWS=1000
MAX_URLS_PER_CHECK=10
CHECK_TIMEOUT_S=60
MAX_UPLOAD_MB=10

# ── Viability ────────────────────────────────────────────────
VIABILITY_MIN_REVIEWS=5

# ── Extraction ───────────────────────────────────────────────
EXTRACTION_STRATEGY=auto
EXTRACT_PAGE_TOKEN_BUDGET=30000
SELECTOR_MIN_AGREEMENT=0.8
CHAT_CORPUS_TOKEN_BUDGET=150000

# ── URL Normalization ────────────────────────────────────────
# Comma-separated query parameters to strip during URL normalization.
TRACKING_PARAMS=utm_source,utm_medium,utm_campaign,utm_term,utm_content,ref,fbclid,gclid

# ── Rate Limits ──────────────────────────────────────────────
RL_CHECKS_PER_IP_HOUR=30
RL_QUESTIONS_PER_IP_HOUR=120
RL_GLOBAL_AI_CALLS_PER_HOUR=2000

# ── Sweeper ──────────────────────────────────────────────────
SWEEP_REQUESTED_AFTER_MIN=5
SWEEP_PROCESSING_STALE_MIN=20

# ── SSRF Protection ──────────────────────────────────────────
# Comma-separated hostnames allowed in addition to public IPs.
# ONLY for local/test use. The app REFUSES to start in production if this is set.
SSRF_TEST_ALLOW_HOSTS=fixtures          # set in compose for the fixtures container

# ── AWS Region ───────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1

# ── WebSocket API ─────────────────────────────────────────────
WS_API_ENDPOINT=https://CHANGEME.execute-api.us-east-1.amazonaws.com/prod
